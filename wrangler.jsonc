{
  // Configurazione del sito su Cloudflare Workers: i file di dist/ (npm run pubblica) dietro il cancello di worker/gate.mjs.
  // Il segreto COOKIE_SECRET NON sta qui: si imposta una volta dal pannello Cloudflare (vedi docs/planning/ACCESSO_SOLO_APPROVATI.md).
  "name": "millennium-duel-arena",
  "main": "worker/gate.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    // "transizione" = senza COOKIE_SECRET il sito resta aperto (serve per la prima pubblicazione); con il segreto si chiude da solo.
    // Dopo aver aggiunto il segreto si porta a "attivo": da li' senza segreto i file riservati restano chiusi.
    "CANCELLO_MODO": "transizione",
    "SUPABASE_URL": "https://yuadnvnkdppgjkagpcwt.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl1YWRudm5rZHBwZ2prYWdwY3d0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc0Mjg1NzAsImV4cCI6MjEwMzAwNDU3MH0.q5g3iUoY4QVdNnHPpkrDcwqNVRV0Qq4n6PmX2DCu5b4"
  }
}
